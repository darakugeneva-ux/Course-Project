    dates = pd.date_range(start='2017-01-01 00:00:00', end='2017-12-30 23:50:00', freq='10min')

    # Генерируем данные
    t = np.arange(len(dates))
    daily_pattern = 5000 * np.sin(2 * np.pi * t / 144)
    weekly_pattern = 1000 * np.sin(2 * np.pi * t / (144 * 7))

    df = pd.DataFrame({
        'DateTime': dates,
        'Temperature': 18 + 8 * np.sin(2 * np.pi * t / 144) + np.random.randn(len(dates)) * 2,
        'Humidity': 70 + 12 * np.cos(2 * np.pi * t / 144) + np.random.randn(len(dates)) * 5,
        'Wind Speed': 3 + np.abs(np.random.randn(len(dates)) * 1.2),
        'Zone 1 Power Consumption': 34000 + daily_pattern + weekly_pattern + np.random.randn(len(dates)) * 800,
        'Zone 2 Power Consumption': 28000 + daily_pattern * 0.85 + weekly_pattern * 0.9 + np.random.randn(
            len(dates)) * 700,
        'Zone 3 Power Consumption': 26500 + daily_pattern * 0.9 + weekly_pattern * 0.8 + np.random.randn(
            len(dates)) * 750
