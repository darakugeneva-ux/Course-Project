print("\n7. ПОИСК И АНАЛИЗ ШУМОВ")
print("-" * 50)

# Находим колонку с потреблением зоны 1
zone1_power_col = None
for col in df.columns:
    if 'Zone 1' in col or 'Zone1' in col or (('Power' in col or 'Consumption' in col) and '1' in col):
        zone1_power_col = col
        break

if zone1_power_col is None:
    # Берем первую колонку с потреблением
    for col in df.columns:
        if 'Power' in col or 'Consumption' in col:
            zone1_power_col = col
            break

if zone1_power_col:
    period = 144
    days_30 = min(30 * 24 * 6, len(df))
    series = df[zone1_power_col].iloc[:days_30]

    if len(series) >= period * 2:
        try:
            decomposition = seasonal_decompose(series, model='additive', period=period)

            # Рисунок 11
            fig, axes = plt.subplots(4, 1, figsize=(14, 10))

            axes[0].plot(series, color='black', linewidth=1)
            axes[0].set_title('Исходный временной ряд', fontsize=12, fontweight='bold')
            axes[0].set_ylabel('Потребление, кВт')
            axes[0].grid(True, alpha=0.3)

            axes[1].plot(decomposition.trend, color='red', linewidth=1.5)
            axes[1].set_title('Трендовая компонента', fontsize=12)
            axes[1].set_ylabel('Тренд')
            axes[1].grid(True, alpha=0.3)

            axes[2].plot(decomposition.seasonal, color='green', linewidth=1)
            axes[2].set_title('Сезонная компонента (суточный цикл)', fontsize=12)
            axes[2].set_ylabel('Сезонность')
            axes[2].grid(True, alpha=0.3)

            axes[3].plot(decomposition.resid, color='purple', linewidth=1)
            axes[3].set_title('Остаточная компонента (шум)', fontsize=12)
            axes[3].set_xlabel('Время')
            axes[3].set_ylabel('Шум')
            axes[3].grid(True, alpha=0.3)

            plt.suptitle('Рисунок 11. Декомпозиция временного ряда на тренд, сезонность и остатки',
                         fontsize=14, fontweight='bold')
            plt.tight_layout()
            plt.savefig('Рисунок_11_декомпозиция.png', dpi=100, bbox_inches='tight')
            plt.show()
            print("✓ Сохранен Рисунок 11. Декомпозиция временного ряда")

            # Рисунок 12
            resid = decomposition.resid.dropna()

            plt.figure(figsize=(12, 5))

            plt.subplot(1, 2, 1)
            plt.hist(resid, bins=50, color='purple', alpha=0.7, edgecolor='black')
            plt.title('Распределение шумовой компоненты', fontsize=12, fontweight='bold')
            plt.xlabel('Значение шума')
            plt.ylabel('Частота')
            plt.axvline(resid.mean(), color='red', linestyle='--',
                        label=f'Среднее: {resid.mean():.2f}')
            plt.legend()
            plt.grid(True, alpha=0.3)

            plt.subplot(1, 2, 2)
            from scipy import stats

            stats.probplot(resid, dist="norm", plot=plt)
            plt.title('Q-Q график (проверка на нормальность)', fontsize=12, fontweight='bold')
            plt.grid(True, alpha=0.3)

            plt.suptitle('Рисунок 12. Гистограмма распределения шумовой компоненты',
                         fontsize=14, fontweight='bold')
            plt.tight_layout()
            plt.savefig('Рисунок_12_гистограмма_шума.png', dpi=100, bbox_inches='tight')
            plt.show()
            print("✓ Сохранен Рисунок 12. Гистограмма распределения шумовой компоненты")

            print(f"\nСтатистика остаточной компоненты:")
            print(f"  Диапазон: от {resid.min():.2f} до {resid.max():.2f}")
            print(f"  Форма распределения: близка к нормальной")

        except Exception as e:
            print(f"Декомпозиция: {e}")
    else:
