if 'text' in train_df.columns and 'toxic' in train_df.columns:
    # Русские стоп-слова
    russian_stopwords = stopwords.words('russian')
    additional_stops = ['это', 'все', 'так', 'вот', 'даже', 'очень', 'можно', 'надо', 'то', 'что', 'как', 'также',
                        'который', 'которая', 'которые', 'которое', 'потому', 'поэтому', 'зачем', 'откуда', 'куда',
                        'туда', 'сюда', 'здесь', 'там', 'тут', 'тогда', 'теперь', 'сейчас', 'всегда', 'никогда']
    russian_stopwords.extend(additional_stops)


    def clean_text(text):
        """Очистка и токенизация русского текста"""
        text = str(text).lower()
        text = re.sub(r'[^\w\s]', '', text)  # удаляем пунктуацию
        text = re.sub(r'\d+', '', text)  # удаляем цифры
        text = re.sub(r'http\S+', '', text)  # удаляем ссылки
        text = re.sub(r'@\w+', '', text)  # удаляем упоминания
        text = re.sub(r'\s+', ' ', text)  # удаляем лишние пробелы
        text = text.strip()

        # Токенизация
        try:
            tokens = word_tokenize(text, language='russian')
        except:
            tokens = text.split()

        # Фильтрация
        tokens = [token for token in tokens if len(token) > 2]
        tokens = [token for token in tokens if token not in russian_stopwords]
        return tokens


    # Анализ для каждого класса
    toxic_texts = train_df[train_df['toxic'] == 1]['text'].tolist()
    nontoxic_texts = train_df[train_df['toxic'] == 0]['text'].tolist()

