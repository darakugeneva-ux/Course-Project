def find_potential_contradictions(df_sample, sample_size=500):
    """Поиск потенциальных противоречий в разметке"""
    contradictions = []

    # Слова-маркеры токсичности
    toxic_markers = ['дебил', 'идиот', 'тупой', 'заткнись', 'пошел', 'убий', 'сдохни', 'клоун', 'бездар']
    # Слова-маркеры нетоксичности
    nontoxic_markers = ['спасиб', 'хорош', 'отличн', 'интересн', 'познавательн', 'согласен', 'спасител']

    sample = df_sample.head(sample_size)
    for idx, row in sample.iterrows():
        text_lower = str(row['text']).lower()

        # Токсичный по разметке, но содержит только нетоксичные маркеры
        if row['toxic'] == 1:
            has_toxic_marker = any(marker in text_lower for marker in toxic_markers)
            has_nontoxic_only = all(
                marker in text_lower for marker in nontoxic_markers[:3]) if not has_toxic_marker else False
            if not has_toxic_marker and len(text_lower.split()) < 30:
                contradictions.append((idx, text_lower[:100], 'toxic_but_no_markers'))

        # Нетоксичный по разметке, но содержит токсичные маркеры
        if row['toxic'] == 0:
            has_toxic_marker = any(marker in text_lower for marker in toxic_markers)
            if has_toxic_marker and len(text_lower.split()) < 30:
                contradictions.append((idx, text_lower[:100], 'nontoxic_but_has_markers'))

    return contradictions


