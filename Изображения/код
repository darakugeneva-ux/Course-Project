# Проверка целостности и поиск дубликатов
def get_image_hash(img_path, size=(32, 32)):
    """Вычисляет хеш изображения для поиска дубликатов"""
    try:
        with Image.open(img_path) as img:
            img_gray = img.convert('L').resize(size)
            img_array = np.array(img_gray)
            # Упрощаем до бинарного изображения
            img_binary = (img_array > img_array.mean()).flatten()
            hash_str = ''.join(img_binary.astype(int).astype(str))
            return hashlib.md5(hash_str.encode()).hexdigest()
    except:
        return None


if os.path.exists(data_path):
    print("Проверка целостности изображений и поиск дубликатов...")

    all_hashes = []
    corrupted = 0

    for cls in classes:
        class_path = os.path.join(data_path, cls)
        if os.path.exists(class_path):
            for img_file in os.listdir(class_path):
                if img_file.endswith(('.jpg', '.jpeg', '.png')):
                    img_path = os.path.join(class_path, img_file)
                    img_hash = get_image_hash(img_path)
                    if img_hash is None:
                        corrupted += 1
                    else:
                        all_hashes.append(img_hash)

    # Поиск дубликатов
    hash_counts = Counter(all_hashes)
    duplicate_groups = sum(1 for count in hash_counts.values() if count > 1)
    duplicate_images = sum(count - 1 for count in hash_counts.values() if count > 1)

    print("\nТаблица 12. Результаты проверки целостности и поиска дубликатов")
    print("-" * 55)
    print(f"{'Показатель':<35} {'Значение':<20}")
    print("-" * 55)
    print(f"{'Всего проверено изображений':<35} {len(all_hashes) + corrupted:<20}")
    print(f"{'Битые/повреждённые файлы':<35} {corrupted:<20}")
    print(f"{'Группы дубликатов':<35} {duplicate_groups:<20}")
    print(f"{'Избыточных дубликатов':<35} {duplicate_images:<20}")
    print(f"{'Доля дубликатов, %':<35} {duplicate_images / (len(all_hashes) + corrupted) * 100:<20.2f}")
    print("-" * 55)

else:
    # Демонстрационные данные
